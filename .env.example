# ==============================================================================
# TaskerBot Environment Configuration
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env
# ==============================================================================

# Telegram Bot Token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key for ultrafast Whisper transcription & Llama 3 (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key for free lightweight models (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI provider for NLP parsing: "auto" (recommended Auto-Fast cascade), "groq", "openrouter", or "gemini"
DEFAULT_AI_PROVIDER=auto

# Local whisper.cpp Server (High performance offline transcription with Metal / AVX)
# Run `bash scripts/run_whisper.sh` to start local server on port 8080
WHISPER_CPP_ENABLED=true
WHISPER_CPP_URL=http://127.0.0.1:8080

# Database URL:
# 1. Supabase PostgreSQL (RECOMMENDED for cloud & 24/7 persistence without data loss):
#    Get URI from Supabase: Project Settings -> Database -> Connection string (URI)
#    Example (Pooler port 6543 or Session port 5432):
#    DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# 2. Local SQLite fallback (aiosqlite driver):
#    DATABASE_URL=sqlite+aiosqlite:///./data/taskerbot.db
DATABASE_URL=sqlite+aiosqlite:///./data/taskerbot.db

# Telegram WebApp Public URL
# For local development with Telegram WebApp, use a tunnel like ngrok or Cloudflare:
# e.g. WEBAPP_URL=https://your-domain.ngrok-free.app
# If left empty, local http://localhost:8000 is used for browser direct access
WEBAPP_URL=

# Telegram OpenID Connect (oauth.telegram.org) & Session JWT
# Configured via @BotFather -> Bot Settings -> OpenID Connect / Domain
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
JWT_SECRET=your_super_secret_jwt_signing_key_32bytes_or_more

# Server Network Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False
